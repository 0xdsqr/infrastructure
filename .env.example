# Copy to .envrc.local and provide values locally. Never commit that file.

# Shared Pulumi backend
PULUMI_ACCESS_TOKEN=

# Cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_R2_API_TOKEN=
CLOUDFLARE_DSQR_DEV_ZONE_ID=
CLOUDFLARE_FIDARA_ZONE_ID=
CLOUDFLARE_TWT_ZONE_ID=
CLOUDFLARE_TUNNEL_SECRET=

# Hetzner
HCLOUD_TOKEN=

# Proxmox
PROXMOX_BASE_URL=
PROXMOX_USER=
PROXMOX_TOKEN_ID=
PROXMOX_TOKEN_SECRET=

# Tailscale
TAILSCALE_OAUTH_CLIENT_ID=
TAILSCALE_OAUTH_CLIENT_SECRET=

# Vault
VAULT_ADDR=
VAULT_TOKEN=

# Recommended: pin the intended Tailscale tailnet explicitly
TAILSCALE_TAILNET=

# Conditional: only needed when the default kubeconfig is unavailable
KUBECONFIG=

# Conditional: only needed when the Vault CA is not in the system trust store
VAULT_CACERT=
