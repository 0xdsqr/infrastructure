# Generated by `nix run .#gitops-generate`.
# Bootstrap installs the same pinned chart; this Application owns day-two changes.
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: argocd
  namespace: ${ARGOCD_NAMESPACE}
  annotations:
    argocd.argoproj.io/sync-wave: "2"
  labels:
    app.kubernetes.io/name: argocd
    app.kubernetes.io/part-of: argocd
    platform.dsqr.dev/owner: platform
    platform.dsqr.dev/lifecycle: controller
    platform.dsqr.dev/tier: gitops
spec:
  project: platform-argocd
  sources:
    - repoURL: ghcr.io/argoproj/argo-helm
      chart: argo-cd
      targetRevision: 10.2.1
      helm:
        releaseName: argocd
        valueFiles:
          - ${VALUES_REF}/${VALUES_COMMON_FILE}
          - ${VALUES_REF}/${VALUES_OVERLAY_FILE}
    - repoURL: ${VALUES_REPO_URL}
      targetRevision: ${VALUES_TARGET_REVISION}
      ref: values
  destination:
    server: ${DESTINATION_SERVER}
    namespace: ${ARGOCD_NAMESPACE}
  syncPolicy:
    automated:
      enabled: false
      prune: false
      selfHeal: false
    retry:
      limit: 3
      refresh: true
      backoff:
        duration: 20s
        factor: 2
        maxDuration: 2m
    syncOptions:
      - ApplyOutOfSyncOnly=true
      - FailOnSharedResource=true
      - DisableClientSideApplyMigration=true
      - ServerSideApply=true
