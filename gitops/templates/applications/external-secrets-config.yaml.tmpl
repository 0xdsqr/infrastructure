# Generated by `nix run .#gitops-generate`.
# Trusted Vault-backed platform and application secret declarations live separately from workloads.
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: external-secrets-config
  namespace: ${ARGOCD_NAMESPACE}
  annotations:
    argocd.argoproj.io/sync-wave: "3"
  labels:
    app.kubernetes.io/instance: external-secrets-config
    app.kubernetes.io/managed-by: argocd
    app.kubernetes.io/name: external-secrets-config
    app.kubernetes.io/part-of: cluster-secrets
    platform.dsqr.dev/owner: platform
    platform.dsqr.dev/tier: platform-addon
spec:
  project: secrets
  source:
    repoURL: ${VALUES_REPO_URL}
    targetRevision: ${VALUES_TARGET_REVISION}
    path: ${VALUES_OVERLAY_DIR}
  destination:
    server: ${DESTINATION_SERVER}
    namespace: external-secrets
  syncPolicy:
    automated:
      enabled: false
      prune: false
      selfHeal: false
    retry:
      limit: 3
      refresh: true
      backoff:
        duration: 20s
        factor: 2
        maxDuration: 2m
    syncOptions:
      - ApplyOutOfSyncOnly=true
      - FailOnSharedResource=true
