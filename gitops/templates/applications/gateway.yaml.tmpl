apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: gateway
  namespace: ${ARGOCD_NAMESPACE}
  annotations:
    argocd.argoproj.io/sync-wave: "4"
  labels:
    app.kubernetes.io/instance: gateway
    app.kubernetes.io/managed-by: argocd
    app.kubernetes.io/name: gateway
    app.kubernetes.io/part-of: cluster-ingress
    platform.dsqr.dev/owner: platform
    platform.dsqr.dev/lifecycle: configuration
    platform.dsqr.dev/tier: platform-addon
spec:
  project: platform-gateway
  source:
    repoURL: ${VALUES_REPO_URL}
    targetRevision: ${VALUES_TARGET_REVISION}
    path: ${VALUES_OVERLAY_DIR}
  destination:
    server: ${DESTINATION_SERVER}
    namespace: gateway-system
  syncPolicy:
    automated:
      enabled: false
      prune: false
      selfHeal: false
    retry:
      limit: 3
      refresh: true
      backoff:
        duration: 20s
        factor: 2
        maxDuration: 2m
    syncOptions:
      - ApplyOutOfSyncOnly=true
      - FailOnSharedResource=true
      - ServerSideApply=true
