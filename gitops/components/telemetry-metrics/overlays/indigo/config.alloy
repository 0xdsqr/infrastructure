logging {
  level = "info"
}

// Alloy v1.20.0's Prometheus TLS transport hashes CA/cert/key files per request
// and rebuilds its transport on changes. Full projected mounts (never subPath)
// allow native reload without pod restarts or rebuilding the remote-write queue.
prometheus.remote_write "beacon" {
  external_labels = {cluster = "indigo", env = "production"}
  endpoint {
    url = "https://beacon-telemetry.service.home.arpa:9443/api/v1/write"
    remote_timeout = "30s"
    tls_config {
      ca_file = "/etc/telemetry/ca/ca.crt"
      cert_file = "/etc/telemetry/tls/tls.crt"
      key_file = "/etc/telemetry/tls/tls.key"
      server_name = "beacon-telemetry.service.home.arpa"
      insecure_skip_verify = false
      min_version = "TLS12"
    }
    queue_config {
      min_shards = 1
      max_shards = 4
      capacity = 10000
      retry_on_http_429 = true
    }
  }
  wal {
    min_keepalive_time = "5m"
    max_keepalive_time = "1h"
    truncate_frequency = "15m"
  }
}

// Explicit inventory: adding a node requires updating this list and RBAC.
discovery.relabel "kubelets" {
  targets = [
    {__address__ = "10.10.80.100:10250", node = "srv-lx-k8s-indigo-control-01"},
    {__address__ = "10.10.80.101:10250", node = "srv-lx-k8s-indigo-control-02"},
    {__address__ = "10.10.80.102:10250", node = "srv-lx-k8s-indigo-control-03"},
    {__address__ = "10.10.80.103:10250", node = "srv-lx-k8s-indigo-worker-01"},
    {__address__ = "10.10.80.104:10250", node = "srv-lx-k8s-indigo-worker-02"},
    {__address__ = "10.10.80.105:10250", node = "srv-lx-k8s-indigo-worker-03"},
    {__address__ = "10.10.80.106:10250", node = "srv-lx-k8s-indigo-worker-04"},
    {__address__ = "10.10.80.107:10250", node = "srv-lx-k8s-indigo-worker-05"},
    {__address__ = "10.10.80.108:10250", node = "srv-lx-k8s-indigo-worker-06"},
  ]
  rule {
    source_labels = ["node"]
    target_label = "instance"
  }
}

prometheus.scrape "kubelet" {
  targets = discovery.relabel.kubelets.output
  job_name = "kubelet"
  scheme = "https"
  scrape_interval = "30s"
  scrape_timeout = "10s"
  bearer_token_file = "/var/run/secrets/kubernetes.io/serviceaccount/token"
  tls_config {
    ca_file = "/var/run/secrets/kubernetes.io/serviceaccount/ca.crt"
    insecure_skip_verify = false
  }
  clustering { enabled = true }
  forward_to = [prometheus.remote_write.beacon.receiver]
}

prometheus.scrape "cadvisor" {
  targets = discovery.relabel.kubelets.output
  job_name = "cadvisor"
  scheme = "https"
  metrics_path = "/metrics/cadvisor"
  scrape_interval = "30s"
  scrape_timeout = "10s"
  bearer_token_file = "/var/run/secrets/kubernetes.io/serviceaccount/token"
  tls_config {
    ca_file = "/var/run/secrets/kubernetes.io/serviceaccount/ca.crt"
    insecure_skip_verify = false
  }
  clustering { enabled = true }
  forward_to = [prometheus.relabel.cadvisor.receiver]
}
prometheus.relabel "cadvisor" {
  // Do not copy arbitrary runtime/container labels into the metric identity.
  rule {
    action = "labeldrop"
    regex = "container_label_.*"
  }
  forward_to = [prometheus.remote_write.beacon.receiver]
}

prometheus.scrape "apiserver" {
  targets = [
    {__address__ = "10.10.80.100:6443", instance = "srv-lx-k8s-indigo-control-01"},
    {__address__ = "10.10.80.101:6443", instance = "srv-lx-k8s-indigo-control-02"},
    {__address__ = "10.10.80.102:6443", instance = "srv-lx-k8s-indigo-control-03"},
  ]
  job_name = "kube-apiserver"
  scheme = "https"
  scrape_interval = "30s"
  scrape_timeout = "10s"
  bearer_token_file = "/var/run/secrets/kubernetes.io/serviceaccount/token"
  tls_config {
    ca_file = "/var/run/secrets/kubernetes.io/serviceaccount/ca.crt"
    insecure_skip_verify = false
  }
  clustering { enabled = true }
  forward_to = [prometheus.relabel.apiserver.receiver]
}

prometheus.relabel "apiserver" {
  // Bound diagnostic cardinality at the source, before the WAL and both Beacon
  // backends. Retain every counter/gauge and histogram sum/count. These five
  // bucket families are not part of our core health/latency SLI contract; their
  // quantiles will no longer be available (averages and totals still are).
  rule {
    source_labels = ["__name__"]
    regex = "apiserver_(request_body_size_bytes|response_sizes|watch_events_sizes|watch_cache_read_wait_seconds|watch_list_duration_seconds)_bucket"
    action = "drop"
  }
  // Classic buckets are cumulative: removing selected boundaries preserves a
  // valid, lower-resolution histogram. Keep +Inf and every identity label.
  // Request latency retains .1/.2/.4/.8/1/2/5/10/30/60/+Inf seconds.
  // The separate apiserver_request_sli_duration_seconds histogram is UNCHANGED.
  rule {
    source_labels = ["__name__", "le"]
    regex = "apiserver_request_duration_seconds_bucket;(0[.](005|025|05|6)|1[.](25|5)|[3468]([.]0)?|15([.]0)?|20([.]0)?|45([.]0)?)"
    action = "drop"
  }
  // etcd latency additionally retains .005/.025/.05 seconds for storage health.
  // Only known redundant boundaries are removed; future buckets pass through.
  rule {
    source_labels = ["__name__", "le"]
    regex = "etcd_request_duration_seconds_bucket;(0[.]6|1[.](25|5)|[3468]([.]0)?|15([.]0)?|20([.]0)?|45([.]0)?)"
    action = "drop"
  }
  forward_to = [prometheus.remote_write.beacon.receiver]
}

// Both KSM replicas expose the full object inventory. Scrape ONE logical
// Service target, assigned to ONE Alloy peer, rather than duplicating series.
prometheus.scrape "kube_state_metrics" {
  targets = [{__address__ = "kube-state-metrics.observability.svc:8080", instance = "indigo"}]
  job_name = "kube-state-metrics"
  honor_labels = true
  scrape_interval = "30s"
  scrape_timeout = "10s"
  clustering { enabled = true }
  forward_to = [prometheus.remote_write.beacon.receiver]
}

prometheus.exporter.self "alloy" {}
prometheus.scrape "self" {
  targets = prometheus.exporter.self.alloy.targets
  job_name = "indigo-alloy"
  scrape_interval = "30s"
  // Each peer reports its own queue/health; don't cluster the local-only target.
  forward_to = [prometheus.relabel.self.receiver]
}
prometheus.relabel "self" {
  rule {
    target_label = "instance"
    replacement = sys.env("HOSTNAME")
  }
  forward_to = [prometheus.remote_write.beacon.receiver]
}
